# Optional overrides for local development. `docker compose up` works WITHOUT this file.
# Copy to .env (git-ignored) only if you want to change a value. Never commit real secrets.

# --- API authentication -------------------------------------------------------
CRAB_API_USERNAME=crab
# Argon2 hash of the password, NOT the password itself. Create one with:
#   python -c "from crab_age.api.auth import hash_password; print(hash_password('my-password'))"
CRAB_API_PASSWORD_HASH=<argon2-hash>
# At least 64 bytes (HS512). Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CRAB_JWT_SECRET_KEY=<random-64-byte-string>
CRAB_JWT_EXPIRE_MINUTES=30

# --- Model registry and monitoring --------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
CRAB_REGISTERED_MODEL_NAME=crab-age
CRAB_MONITORING_DB_URL=sqlite:///monitoring.db
CRAB_INFERENCE_EXPERIMENT=crab-age-inference
CRAB_INFERENCE_BATCH_SIZE=10
